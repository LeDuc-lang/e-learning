# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Clé publique du projet (ancien nom : anon key, nouveau nom : publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Modèle d'IA hébergé (API compatible OpenAI, appelée côté serveur uniquement).
# L'URL de base et le modèle doivent appartenir au même fournisseur que la clé.
# Exemple Groq (clé commençant par gsk_) :
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=your-api-key
AI_MODEL=openai/gpt-oss-20b
# Exemple OpenAI (clé commençant par sk_) :
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Limitation de débit par utilisateur (facultatif, valeurs par défaut ci-dessous)
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MINUTES=60

# Tarifs du modèle, en dollars par million de tokens (facultatif).
# Sert uniquement à estimer le coût affiché dans /admin. Sans valeurs, le coût
# n'est pas calculé (affiché « — »).
# Exemple Groq openai/gpt-oss-20b : 0.075 en entrée, 0.30 en sortie.
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0

# Suivi des erreurs (facultatif). Sans DSN, Sentry reste inactif.
# Un seul DSN suffit : NEXT_PUBLIC_SENTRY_DSN est lu par le navigateur et,
# à défaut de SENTRY_DSN, par le serveur. Un DSN n'est pas un secret.
# NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...
# Pour l'envoi des source maps au build (Vercel) — facultatif :
# SENTRY_AUTH_TOKEN=...
# SENTRY_ORG=...
# SENTRY_PROJECT=...
# Même jeton + org + projet : /admin interroge le projet Sentry. Un jeton sans
# droit de lecture affiche « API joignable · jeton sans accès au projet ».
# Région de l'API déduite du DSN ; à forcer si besoin (ex. auto-hébergement) :
# SENTRY_API_URL=https://de.sentry.io

# Surveillance externe. Requise pour que /admin confirme UptimeRobot opérationnel.
# UptimeRobot > My Settings > API Keys (clé de type « read-only » suffit).
# UPTIMEROBOT_API_KEY=ur...
